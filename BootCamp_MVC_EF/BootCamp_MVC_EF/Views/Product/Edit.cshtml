@model Product
@{
    ViewData["Title"] = "Edit Product";
}
<div class="container">
    <h1>Edit Product</h1>
    <form asp-action="Edit" method="post">
        <div class="text-danger" asp-validation-summary="All">
        </div>
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="ProductName" class="control-label"></label>
            <input asp-for="ProductName" class="form-control" />
            <span class="text-danger" asp-validation-for="ProductName"></span>
        </div>
        <div class="form-group">
            <label asp-for="Type" class="control-label"></label>
            <input asp-for="Type" class="form-control" />
            <span class="text-danger" asp-validation-for="Type"></span>
        </div>
        <div class="form-group">
            <label asp-for="PowerWatt" class="control-label"></label>
            <input asp-for="PowerWatt" class="form-control" />
            <span class="text-danger" asp-validation-for="PowerWatt"></span>
        </div>
        <div class="form-group">
            <label asp-for="Price" class="control-label"></label>
            <input asp-for="Price" class="form-control" />
            <span class="text-danger" asp-validation-for="Price"></span>
        </div>
        <div class="form-group">
            <label asp-for="StockQuantity" class="control-label"></label>
            <input asp-for="StockQuantity" class="form-control" />
            <span class="text-danger" asp-validation-for="StockQuantity"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}