@model Employee
@{
    ViewData["Title"] = "Edit Employee";
}
<div class="container">
    <h1>Edit Employee</h1>
    <form asp-action="Edit" method="post">
        <div class="text-danger" asp-validation-summary="All">
        </div>
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="EmployeeName" class="control-label"></label>
            <input asp-for="EmployeeName" class="form-control" />
            <span class="text-danger" asp-validation-for="EmployeeName"></span>
        </div>
        <div class="form-group">
            <label asp-for="Position" class="control-label"></label>
            <input asp-for="Position" class="form-control" />
            <span class="text-danger" asp-validation-for="Position"></span>
        </div>
        <div class="form-group">
            <label asp-for="Department" class="control-label"></label>
            <input asp-for="Department" class="form-control" />
            <span class="text-danger" asp-validation-for="Department"></span>
        </div>
        <div class="form-group">
            <label asp-for="Salary" class="control-label"></label>
            <input asp-for="Salary" class="form-control" />
            <span class="text-danger" asp-validation-for="Salary"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}