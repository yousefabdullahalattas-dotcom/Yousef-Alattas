@model Order
@{
    ViewData["Title"] = "Delete Order";
}
<div class="container">
    <h1>Delete Order</h1>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label>Customer</label>
            <input class="form-control" value="@Model.Customer?.CustomerName" readonly />
        </div>
        <div class="form-group">
            <label>Product</label>
            <input class="form-control" value="@Model.Product?.ProductName" readonly />
        </div>
        <div class="form-group">
            <label asp-for="Quantity" class="control-label"></label>
            <input asp-for="Quantity" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="TotalPrice" class="control-label"></label>
            <input asp-for="TotalPrice" class="form-control" readonly />
        </div>
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div><a asp-action="Index">Back to List</a></div>
</div>